{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/loopx/worker-result.schema.json",
  "title": "loopx prompt worker result",
  "type": "object",
  "additionalProperties": false,
  "required": ["outcome", "agent_instance_id", "selected_provider", "model", "routing_reason", "available_providers", "payload", "artifact"],
  "properties": {
    "outcome": {"enum": ["completed", "failed", "blocked", "interrupted"]},
    "agent_instance_id": {"type": ["string", "null"]},
    "selected_provider": {"type": ["string", "null"]},
    "model": {"type": ["string", "null"]},
    "routing_reason": {"type": "string"},
    "available_providers": {"type": "array", "items": {"type": "string"}},
    "payload": {"type": "object"},
    "artifact": {"type": ["string", "null"]},
    "cleanup_warning": {"type": "string"}
  }
}
