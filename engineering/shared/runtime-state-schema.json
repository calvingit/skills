{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-skills:runtime-state:v1",
  "title": "Graph Workflow runtime state",
  "description": "Local execution progress of one task, stored in the task's .loop/state.json. Ephemeral and Git-ignored: it records current judgement and the index needed to locate evidence, never the ticket contract or a full report.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tickets"],
  "properties": {
    "schema_version": {"const": 1},
    "tickets": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/ticket_state"}
    }
  },
  "$defs": {
    "path_list": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt", "summary"],
      "properties": {
        "attempt": {"type": "integer", "minimum": 1},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "ticket_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase"],
      "properties": {
        "phase": {"enum": ["open", "in_progress", "done", "superseded"]},
        "attempt": {"type": "integer", "minimum": 0},
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fingerprint", "reason"],
          "properties": {
            "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "reason": {"type": "string", "minLength": 1}
          }
        },
        "review": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/evidence"}
        },
        "blocker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["category", "reason", "release_condition"],
          "properties": {
            "category": {"enum": ["requirement", "design", "dependency", "environment", "permission", "external"]},
            "reason": {"type": "string", "minLength": 1},
            "release_condition": {"type": "string", "minLength": 1}
          }
        },
        "current_attempt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["number", "baseline", "existing_changes", "allowed_write_scope"],
          "properties": {
            "number": {"type": "integer", "minimum": 1},
            "baseline": {
              "type": "object",
              "additionalProperties": false,
              "required": ["reference", "staged", "unstaged", "untracked"],
              "properties": {
                "reference": {"type": "string", "minLength": 1},
                "staged": {"$ref": "#/$defs/path_list"},
                "unstaged": {"$ref": "#/$defs/path_list"},
                "untracked": {"$ref": "#/$defs/path_list"}
              }
            },
            "existing_changes": {
              "type": "object",
              "additionalProperties": false,
              "required": ["included", "excluded"],
              "properties": {
                "included": {"$ref": "#/$defs/path_list"},
                "excluded": {"$ref": "#/$defs/path_list"}
              }
            },
            "allowed_write_scope": {"$ref": "#/$defs/path_list"}
          }
        },
        "reopen_context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["review_finding", "invalidated_acceptance"],
          "properties": {
            "review_finding": {"type": "string", "minLength": 1},
            "invalidated_acceptance": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^AC[0-9]+$"}}
          }
        }
      }
    }
  }
}
