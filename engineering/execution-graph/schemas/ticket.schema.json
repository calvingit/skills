{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/codex/execution-graph/ticket.schema.json",
  "title": "Loop ticket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "covers",
    "design_decisions",
    "what_to_build",
    "constraints",
    "acceptance_criteria",
    "dependencies",
    "lifecycle",
    "execution",
    "supersession"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^T[0-9]{3,}$"},
    "title": {"type": "string", "minLength": 1},
    "covers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirements", "spec_acceptance"],
      "properties": {
        "requirements": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^R[0-9]+$"}},
        "spec_acceptance": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^AC[0-9]+$"}}
      }
    },
    "design_decisions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^D[0-9]+$"}},
    "what_to_build": {"type": "string", "minLength": 1},
    "constraints": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": {"type": "string", "pattern": "^AC[0-9]+$"},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^T[0-9]{3,}$"}},
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase"],
      "properties": {"phase": {"enum": ["open", "in_progress", "done", "superseded"]}}
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_sequence", "evidence", "blocker", "current_attempt", "reopen_context"],
      "properties": {
        "attempt_sequence": {"type": "integer", "minimum": 0},
        "evidence": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["result", "summary"],
            "properties": {
              "result": {"const": "passed"},
              "summary": {"type": "string", "minLength": 1}
            }
          }
        },
        "blocker": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["category", "reason", "release_condition"],
              "properties": {
                "category": {"enum": ["requirement", "design", "environment", "permission", "external"]},
                "reason": {"type": "string", "minLength": 1},
                "release_condition": {"type": "string", "minLength": 1}
              }
            }
          ]
        },
        "current_attempt": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/current_attempt"}
          ]
        },
        "reopen_context": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["review_finding", "invalidated_acceptance"],
              "properties": {
                "review_finding": {"type": "string", "minLength": 1},
                "invalidated_acceptance": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^AC[0-9]+$"}}
              }
            }
          ]
        }
      }
    },
    "supersession": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason", "replacement_ticket_id"],
          "properties": {
            "reason": {"type": "string", "minLength": 1},
            "replacement_ticket_id": {"type": ["string", "null"], "pattern": "^T[0-9]{3,}$"}
          }
        }
      ]
    }
  },
  "$defs": {
    "path_list": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "current_attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "baseline", "existing_changes", "allowed_write_scope"],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reference", "staged", "unstaged", "untracked"],
          "properties": {
            "reference": {"type": "string", "minLength": 1},
            "staged": {"$ref": "#/$defs/path_list"},
            "unstaged": {"$ref": "#/$defs/path_list"},
            "untracked": {"$ref": "#/$defs/path_list"}
          }
        },
        "existing_changes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["included", "excluded"],
          "properties": {
            "included": {"$ref": "#/$defs/path_list"},
            "excluded": {"$ref": "#/$defs/path_list"}
          }
        },
        "allowed_write_scope": {"$ref": "#/$defs/path_list"}
      }
    }
  }
}
