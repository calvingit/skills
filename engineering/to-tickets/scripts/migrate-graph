#!/usr/bin/env python3
import _bootstrap
from ticket_graph.command import parser, task_argument, request, run
from migration import migrate
from ticket_graph.recovery import recover_transaction
p = parser("Explicit v1 -> v2 field migration, or recovery of an interrupted graph transaction.")
task_argument(p)
p.add_argument('--recover', choices=['commit', 'rollback'])
a = p.parse_args()
raise SystemExit(run('migrate', lambda: recover_transaction(a.task_dir, a.recover) if a.recover else migrate(a.task_dir)))
