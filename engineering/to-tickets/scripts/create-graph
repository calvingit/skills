#!/usr/bin/env python3
import _bootstrap
from ticket_graph.command import parser, task_argument, request, run
from ticket_graph.migrate import migrate_v3
from planning import create_batch, reconcile_batch
p = parser("Create, reconcile, or convert a confirmed v4 Markdown ticket graph.")
p.add_argument('operation', choices=['create-batch', 'reconcile-batch', 'migrate-v3'])
task_argument(p)
p.add_argument('--input', help='JSON request path, or - for stdin; see ../references/script-inputs.md')
a = p.parse_args()
if a.operation != 'migrate-v3' and not a.input: p.error('--input is required')
def action():
    if a.operation == 'migrate-v3': return migrate_v3(a.task_dir)
    return (create_batch if a.operation == 'create-batch' else reconcile_batch)(a.task_dir, request(a.input))
raise SystemExit(run(a.operation, action))
