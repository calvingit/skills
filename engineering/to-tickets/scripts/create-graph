#!/usr/bin/env python3
import _bootstrap
from ticket_graph.command import parser, task_argument, request, run
from planning import create_batch, reconcile_batch, migrate_graph
p = parser("Create, reconcile or migrate a confirmed execution graph of Markdown tickets (shared v3 schema).")
p.add_argument('operation', choices=['create-batch', 'reconcile-batch', 'migrate'])
task_argument(p)
p.add_argument('--input', help='JSON request path, or - for stdin; see ../references/script-inputs.md')
mode = p.add_mutually_exclusive_group()
mode.add_argument('--dry-run', action='store_true', help='migrate: validate and report the conversion without writing (default)')
mode.add_argument('--apply', action='store_true', help='migrate: commit the conversion and remove the JSON tickets')
a = p.parse_args()
if a.operation == 'migrate':
    if a.input: p.error('migrate takes no --input')
    raise SystemExit(run(a.operation, lambda: migrate_graph(a.task_dir, apply=a.apply)))
if not a.input: p.error('--input is required')
if a.dry_run or a.apply: p.error('--dry-run/--apply apply to migrate only')
raise SystemExit(run(a.operation, lambda: (create_batch if a.operation == 'create-batch' else reconcile_batch)(a.task_dir, request(a.input))))
