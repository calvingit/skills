{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-skills:ticket:v4",
  "title": "Graph Workflow ticket contract",
  "description": "The stable delivery contract of one ticket. Lifecycle, attempts, evidence, blockers and authority live in .loop/state.json; see runtime-state-schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "covers",
    "referenced_design_decisions",
    "what_to_build",
    "constraints",
    "delivery_acceptance",
    "dependencies"
  ],
  "properties": {
    "schema_version": {"const": 4},
    "id": {"type": "string", "pattern": "^T[0-9]{3,}$"},
    "title": {"type": "string", "minLength": 1},
    "covers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirements", "spec_acceptance"],
      "properties": {
        "requirements": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^R[0-9]+$"}},
        "spec_acceptance": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^AC[0-9]+$"}}
      }
    },
    "referenced_design_decisions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^D[0-9]+$"}},
    "what_to_build": {"type": "string", "minLength": 1},
    "constraints": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "delivery_acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": {"type": "string", "pattern": "^AC[0-9]+$"},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^T[0-9]{3,}$"}},
    "supersession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "replacement_ticket_id"],
      "properties": {
        "reason": {"type": "string", "minLength": 1},
        "replacement_ticket_id": {"type": ["string", "null"], "pattern": "^T[0-9]{3,}$"}
      }
    }
  },
  "$defs": {
    "path_list": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
